# ==============================================================================
# Variables de Entorno - TechNova Solutions / CampusDESK
# Copie este archivo como .env y ajuste sus valores según el entorno.
# ==============================================================================

# Base de Datos PostgreSQL
DB_URL= (AQUI URL DE TU BASE DE DATOS)
DB_USERNAME= (NOMBRE DE TU BASE DE DATOS) 
DB_PASSWORD= (CONTRASEÑA DE TU BASE DE DATOS)

# Seguridad JWT (Debe ser un string seguro de al menos 256 bits)
JWT_SECRET= 
JWT_EXPIRATION=(NUMERO DE EXPIRACION DE 8 DIGITOS )

# Servidor y CORS
SERVER_PORT=    
CORS_ALLOWED_ORIGINS= (CORDENAS PERMITIDAS PARA PODER ACCEDER A LA PAGUINA)
