# Base de Datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5438/campusDESK
DB_USERNAME=dev_user
DB_PASSWORD=DevTeamSecurePass2026!

# Seguridad JWT (Debe ser un string seguro de al menos 256 bits)
JWT_SECRET=campusDeskSecretKey2026SuperSecureRandomStringAtLeast256BitsLong!!
JWT_EXPIRATION=86400000

# Servidor y CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501
